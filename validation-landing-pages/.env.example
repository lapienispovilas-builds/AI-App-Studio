# General validation leads -> Google Sheets. The service account values below
# stay server-side in Vercel. Share the target sheet with the service account.
LEADS_GOOGLE_SHEETS_SPREADSHEET_ID=
LEADS_GOOGLE_SHEETS_SHEET_NAME=Evera Leads

# Evera authentication. Create a Supabase project, run supabase/evera_profiles.sql,
# then copy the project URL and public anon key here.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY
# Server-only values used by the verified Stripe purchase claim endpoint.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY

# Stripe Checkout. Keep secret values server-only in Vercel environment variables.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_7_DAY_PRICE_ID=
STRIPE_30_DAY_PRICE_ID=
STRIPE_90_DAY_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
VITE_STRIPE_CHECKOUT_ENDPOINT=/api/create-checkout-session
EVERA_APP_URL=https://everahealth.pro

# Optional legacy Payment Links. The API Checkout flow above is required for
# verified entitlement persistence and personalized result restoration.
VITE_STRIPE_LINK_7_DAY=STRIPE_LINK_7_DAY
VITE_STRIPE_LINK_30_DAY=STRIPE_LINK_30_DAY
VITE_STRIPE_LINK_90_DAY=STRIPE_LINK_90_DAY

# PostHog analytics. Browser analytics is enabled only in production unless
# VITE_POSTHOG_DEBUG=true is set locally for event testing.
VITE_POSTHOG_PROJECT_TOKEN=
VITE_POSTHOG_HOST=https://eu.i.posthog.com
VITE_POSTHOG_DEBUG=false

# Chapter student quiz -> Google Sheets. These values are server-only and must
# be configured in Vercel; never prefix them with VITE_.
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEETS_SHEET_NAME=Chapter Students
