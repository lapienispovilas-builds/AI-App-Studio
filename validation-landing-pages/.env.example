# Paste the /exec URL from your deployed Google Apps Script web app here.
VITE_GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/REPLACE_WITH_YOUR_DEPLOYMENT_ID/exec

# Evera authentication. Create a Supabase project, run supabase/evera_profiles.sql,
# then copy the project URL and public anon key here.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY

# Optional server endpoint that creates a Stripe Checkout Session and returns { "url": "..." }.
# Without this value, Evera uses an explicitly labeled local test checkout.
VITE_STRIPE_CHECKOUT_ENDPOINT=

# Alternatively, use one Stripe Payment Link per Evera program. Configure each
# link's successful-payment redirect to https://everahealth.pro/create-account?checkout=success
VITE_STRIPE_LINK_7_DAY=STRIPE_LINK_7_DAY
VITE_STRIPE_LINK_30_DAY=STRIPE_LINK_30_DAY
VITE_STRIPE_LINK_90_DAY=STRIPE_LINK_90_DAY
